{
  "image": "mcr.microsoft.com/devcontainers/universal:5",/*Ubuntu 24.04.4 LTS (noble)*/
  "features": {
    "ghcr.io/devcontainers-extra/features/apt-get-packages:1": {
      "packages": "inetutils-ping,netcat-openbsd"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "chmod +x ~/.bash_profile ~/.bashrc ~/.inputrc",
  "portsAttributes": {
    "2222": {
      "label": "sshd"
    }
  },
  "forwardPorts": [2222]
}
